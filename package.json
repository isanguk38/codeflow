{
  "name": "codeflow",
  "productName": "CodeFlow",
  "version": "0.5.3",
  "description": "보기 쉽고 사용하기 간편한 Git 형상관리 데스크톱 툴",
  "main": "src/main/main.js",
  "author": "isanguk38",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/isanguk38/codeflow.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "@lydell/node-pty-win32-x64": "1.2.0-beta.15",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "diff": "^5.2.0",
    "monaco-editor": "^0.52.2",
    "pyright": "^1.1.414",
    "typescript": "^5.6.3",
    "typescript-language-server": "^4.3.4"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.isanguk38.codeflow",
    "productName": "CodeFlow",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json",
      "!node_modules/monaco-editor/{esm,dev,min-maps}/**",
      "!node_modules/monaco-editor/**/*.map",
      "!node_modules/typescript/lib/{cs,de,es,fr,it,ja,pl,pt-br,ru,tr,zh-cn,zh-tw}/**",
      "!node_modules/**/*.d.ts.map",
      "!node_modules/pyright/dist/*.map"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "CodeFlow-Setup-${version}.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "isanguk38",
      "repo": "codeflow",
      "releaseType": "release"
    },
    "portable": {
      "artifactName": "CodeFlow-${version}-Portable.exe"
    },
    "asarUnpack": [
      "node_modules/typescript-language-server/**",
      "node_modules/typescript/**",
      "node_modules/@lydell/**",
      "node_modules/pyright/**"
    ]
  }
}
