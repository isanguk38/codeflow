{
  "name": "codeflow",
  "productName": "CodeFlow",
  "version": "0.1.0",
  "description": "보기 쉽고 사용하기 간편한 Git 형상관리 데스크톱 툴",
  "main": "src/main/main.js",
  "author": "isanguk38",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.isanguk38.codeflow",
    "productName": "CodeFlow",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "diff": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
