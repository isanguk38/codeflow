{
  "name": "codeflow",
  "productName": "CodeFlow",
  "version": "0.2.0",
  "description": "보기 쉽고 사용하기 간편한 Git 형상관리 데스크톱 툴",
  "main": "src/main/main.js",
  "author": "isanguk38",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/isanguk38/codeflow.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "diff": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.isanguk38.codeflow",
    "productName": "CodeFlow",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "CodeFlow-Setup-${version}.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "isanguk38",
      "repo": "codeflow",
      "releaseType": "release"
    },
    "portable": {
      "artifactName": "CodeFlow-${version}-Portable.exe"
    }
  }
}
